# CultureLens-RC environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# === Azure AI Foundry (required for running experiments) ===
# Your Azure OpenAI deployment of an OpenAI-compatible model.
# We used gpt-5.4-mini (an Azure-specific deployment name); use whatever
# OpenAI-compatible model you have access to (e.g. gpt-4o-mini, gpt-4o).
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_DEPLOYMENT_NAME=gpt-4o-mini

# Backward-compat: the code reads AZURE_API_KEY as well.
AZURE_API_KEY=your_azure_key_here

# === Gemini (optional, only for regenerating pipeline figures) ===
GEMINI_API_KEY=your_gemini_key_here

# === Project root (optional override; defaults to current dir) ===
EXPERIMENT_ROOT=./
